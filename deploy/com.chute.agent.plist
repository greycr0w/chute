<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fire-and-forget agent on your Mac. launchd keeps it alive across reboots,
  sleep/wake and crashes; the agent's own backoff loop handles network blips.

  Put the token in a private file, then edit the paths/host below:
    install -d -m 700 ~/.config/chute ~/Library/Logs/chute
    printf '%s\n' 'CHANGE_ME_TOKEN' > ~/.config/chute/token
    chmod 600 ~/.config/chute/token
    cp deploy/com.chute.agent.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.chute.agent.plist
  Stop with:
    launchctl unload -w ~/Library/LaunchAgents/com.chute.agent.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chute.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGE_ME/Development/chute/.venv/bin/chute</string>
    <string>8000</string>
    <string>--server</string>
    <string>tunnel.example.com</string>
    <string>--token-file</string>
    <string>/Users/CHANGE_ME/.config/chute/token</string>
    <string>--server-cert</string>
    <string>/Users/CHANGE_ME/Development/chute/chute-cert.pem</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/CHANGE_ME/Library/Logs/chute/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGE_ME/Library/Logs/chute/agent.err.log</string>
</dict>
</plist>
